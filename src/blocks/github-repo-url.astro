---
import { LuGithub } from "react-icons/lu"

interface Props {
  repositoryUrl: string
}

const { repositoryUrl } = Astro.props
---

<a
  class="flex w-fit items-center gap-1 text-sm text-wrap text-muted-foreground hover:text-foreground"
  href={repositoryUrl}
  target="_blank"
  rel="noopener"
>
  <LuGithub />

  <p>Github</p>
</a>
